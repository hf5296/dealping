# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-value
MAINTENANCE_MODE=false
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dealping

# Keepa product data
KEEPA_API_KEY=
KEEPA_MAX_TOKENS=100
KEEPA_REFILL_PER_MINUTE=5
KEEPA_RESERVE_TOKENS=10

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL="DealPing <notifications@example.com>"

# Scheduled jobs
CRON_SECRET=replace-with-a-separate-long-random-value

# Optional Amazon affiliate integration
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Optional Awin affiliate integration
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
